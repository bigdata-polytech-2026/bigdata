# Docker/Compose distribution. Do not put credentials in Git.
# Default directory is intentionally empty: setup/tests do not require S3 access.
# For make data/data-full set this to the absolute directory containing AWS
# credentials and config, e.g. /home/alice/.aws or /Users/alice/.aws.
AWS_DIR=./infra/empty-aws
AWS_PROFILE=technical-lag

# Optional container-visible DVC cache. Empty = this checkout .dvc/cache.
DVC_CACHE_DIR=
BIGDATA_MEMORY=4g
BIGDATA_CPUS=2
# Advanced: common storage mount for several clean checkouts sharing hardlinks.
# Defaults work for a normal clone; see README low-disk verification notes.
PROJECT_STORAGE_ROOT=.
PROJECT_SUBDIR=.

# Collector overrides (not used by demo or full reproduction).
NPM_REGISTRY_URL=https://registry.npmjs.org
NPM_SEARCH_QUERY=keywords:javascript
BIGDATA_DATA_DIR=data
