# Local configuration and credentials
.env
.env.*
!.env.example

# Python and Node artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
dist/
build/

# Data and generated outputs
data/
data-test/
raw/
normalized/
results/
artifacts/
# Data payloads live in DVC; Git keeps only metadata and the documented layout.
data/**
!data/**/
!data/**/*.dvc
!data/**/.gitignore
!data/**/.gitkeep
!data/README.md

# Generated outputs outside data/
/raw/
/normalized/
/results/
/artifacts/
*.parquet
*.arrow
*.duckdb
*.sqlite

# macOS
.DS_Store
